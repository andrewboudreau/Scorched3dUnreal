# --- Ignore ALL hidden / dot-prefixed folders (.vs, .vscode, .idea, .tmp, etc.) ---
# Covers the legacy Scorched3D source checkout in .tmp/ (reference only).
# Exception: .github must stay tracked — GitHub Actions / Pages config lives there.
.*/
!.github/

# --- Large UE binary assets — kept OUT of the repo for now (add later if wanted) ---
/Content/

# --- Python bytecode cache (wiki tools) ---
__pycache__/

# --- Unreal Engine project ---
# Build / intermediate / generated
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.vscode/
*.VC.db
*.opensdf
*.sdf
*.suo
*.sln
*.xcodeproj/
*.xcworkspace/

# Generated code & headers
*.generated.h

# Unreal autosaves / backups
*.autosave
Autosaves/

# Plugin build artifacts
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Compiled binaries / libraries
*.dll
*.dylib
*.so
*.exe
*.lib
*.a
*.app
*.pdb
*.obj
*.o

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Crash / log files
*.log
Crashes/

# MCP browser tool — generated graph cache
tools/.mcp-graph-cache.json
